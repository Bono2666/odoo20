<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!--
        Shared QWeb scaffolding for ERP Heritage suite PDF reports.

        Per-module reports include this stylesheet via t-call so the
        visual identity stays consistent without each addon shipping its
        own CSS. Key conventions:

        * .eh_pdf_page wraps the page body and sets the suite font and
          base text colour.
        * .eh_pdf_title is the H1 above the report content.
        * .eh_pdf_meta is the small grey strip immediately under the
          title (date range, currency, generated-at).
        * .eh_pdf_table is the standard tabular layout used by ledgers,
          registers, and statements.
        * .eh_pdf_summary_box is the bordered key/value box used by
          single-record reports (asset card, statement, dunning letter).
        * .eh_pdf_footer is the suite footer line; per-module reports
          can hide it by setting the show_eh_footer t-set to False
          before the call.

        Colours are HEX literals so wkhtmltopdf does not need a fonts
        package for HSL or named colour parsing. A4 landscape is the
        default paper format for tabular reports.
    -->

    <template id="eh_report_styles">
        <style type="text/css">
            /*
                Typography is pinned to faces the machine already has.

                The report body that Odoo hands to the PDF engine carries the
                company layout class, which sets the downloadable company font
                (Lato, Roboto and the rest). A PDF engine that fails to embed
                one of those faces does not warn: it drops every run of text
                set in that face, so a statement can print with its invoice
                rows missing and still look like a valid document. Pinning an
                installed stack for the printed body makes every suite report
                render the same on every run and on every machine.

                The rule is deliberately scoped to the report body. This
                stylesheet is only ever rendered inside a suite report, and
                the company letterhead band is a separate document that the
                engine builds from the company layout, so neither other
                reports nor the customer's chosen letterhead font change.
            */
            div.article {
                font-family: "DM Sans", "Helvetica Neue", Arial, sans-serif;
            }
            .eh_pdf_page {
                font-family: "DM Sans", "Helvetica Neue", Arial, sans-serif;
                font-size: 10.5pt;
                color: #2c3e50;
                line-height: 1.45;
            }
            .eh_pdf_title {
                font-size: 22pt;
                font-weight: 700;
                color: #1a2332;
                margin: 0 0 4pt 0;
                letter-spacing: -0.01em;
            }
            .eh_pdf_subtitle {
                font-size: 12pt;
                font-weight: 700;
                color: #1a2332;
                margin: 16pt 0 6pt 0;
                letter-spacing: 0.01em;
            }
            .eh_pdf_meta {
                font-size: 9.5pt;
                color: #495057;
                margin-bottom: 14pt;
                line-height: 1.6;
            }
            .eh_pdf_meta strong { color: #1a2332; font-weight: 600; }
            .eh_pdf_meta span { margin-right: 14pt; }

            .eh_pdf_table {
                width: 100%;
                border-collapse: collapse;
                font-size: 10pt;
            }
            .eh_pdf_table thead th {
                background: #1a2332;
                color: #fdf6e3;
                border-bottom: 1.5pt solid #C9A372;
                padding: 7pt 9pt;
                font-weight: 700;
                text-align: left;
                font-size: 8.5pt;
                text-transform: uppercase;
                letter-spacing: 0.06em;
            }
            .eh_pdf_table tbody td {
                padding: 7pt 9pt;
                border-bottom: 0.4pt solid #e6e0d4;
                font-size: 10pt;
                vertical-align: top;
            }
            .eh_pdf_table tbody tr:nth-child(even) td {
                background: #faf6ee;
            }
            .eh_pdf_table .text-end { text-align: right; }
            .eh_pdf_table .text-center { text-align: center; }
            .eh_pdf_table .text-muted { color: #6c757d; }
            /* For cells a reader must never see broken across two lines,
               such as a date or a reference on a crowded register. */
            .eh_pdf_table .eh_pdf_nowrap { white-space: nowrap; }

            .eh_pdf_table tr.eh_pdf_section_header td {
                background: #e9ecef;
                font-weight: 700;
                font-size: 9.5pt;
                border-top: 1pt solid #495057;
            }
            .eh_pdf_table tr.eh_pdf_section_total td {
                background: #f1f3f5;
                font-weight: 700;
                border-top: 1pt solid #495057;
            }
            .eh_pdf_table tr.eh_pdf_grand_total td {
                background: #fff3cd;
                font-weight: 700;
                border-top: 1.5pt solid #ffc107;
                border-bottom: 1.5pt solid #ffc107;
            }

            .eh_pdf_summary_box {
                border: 0.5pt solid #adb5bd;
                background: #fafbfc;
                padding: 8pt 10pt;
                margin-bottom: 10pt;
                font-size: 9pt;
            }
            .eh_pdf_summary_box .label {
                color: #6c757d;
                text-transform: uppercase;
                font-size: 7.5pt;
                letter-spacing: 0.04em;
                margin-bottom: 1pt;
            }
            .eh_pdf_summary_box .value {
                font-size: 10pt;
                font-weight: 600;
                color: #2c3e50;
            }

            .eh_pdf_signature_block {
                margin-top: 28pt;
                font-size: 8.5pt;
                color: #495057;
            }
            .eh_pdf_signature_line {
                border-top: 0.5pt solid #495057;
                width: 50%;
                margin-top: 18pt;
                padding-top: 4pt;
                font-size: 8pt;
                color: #6c757d;
            }

            .eh_pdf_status_badge {
                display: inline-block;
                padding: 1pt 6pt;
                border-radius: 8pt;
                font-size: 7.5pt;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.04em;
            }
            .eh_pdf_status_ok      { background: #d4edda; color: #155724; }
            .eh_pdf_status_warn    { background: #fff3cd; color: #856404; }
            .eh_pdf_status_danger  { background: #f8d7da; color: #721c24; }
            .eh_pdf_status_info    { background: #d1ecf1; color: #0c5460; }
            .eh_pdf_status_neutral { background: #e2e3e5; color: #383d41; }

            .eh_pdf_footer {
                margin-top: 22pt;
                padding-top: 8pt;
                border-top: 0.5pt solid #C9A372;
                text-align: center;
                letter-spacing: 0.04em;
            }
            .eh_pdf_footer_brand {
                font-size: 8pt;
                color: #495057;
                font-weight: 700;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                margin-bottom: 2pt;
            }
            .eh_pdf_footer_credit {
                font-size: 7.5pt;
                color: #6c757d;
                font-style: italic;
                letter-spacing: 0.02em;
            }
            .eh_pdf_heart {
                color: #C9A372;
                font-size: 9pt;
                padding: 0 2pt;
                font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif;
            }
            .eh_pdf_header {
                margin: 0 0 18pt 0;
                padding: 0 0 14pt 0;
                border-bottom: 1pt solid #C9A372;
            }
            .eh_pdf_header_brand {
                font-size: 8pt;
                font-weight: 700;
                letter-spacing: 0.16em;
                color: #C9A372;
                text-transform: uppercase;
                margin-bottom: 4pt;
            }
            .eh_pdf_header_company {
                font-size: 9pt;
                color: #6c757d;
                margin-top: 4pt;
            }
        </style>
    </template>

    <!--
        Statutory footer block. Per-module reports include with:

            <t t-call="eh_account_base.eh_report_footer"/>

        Footer identifies reporting company only. Vendor/support marketing
        does not belong on customer-facing accounting evidence.
    -->
    <template id="eh_report_footer">
        <div class="eh_pdf_footer">
            <div class="eh_pdf_footer_brand" t-if="company">
                <t t-out="company.display_name"/>
            </div>
            <div class="eh_pdf_footer_credit" t-if="company and company.vat">
                Tax ID <t t-out="company.vat"/>
            </div>
        </div>
    </template>

    <!--
        Suite-branded header band. Replaces web.external_layout for
        reports that want full visual control over the page header
        instead of inheriting the company-default layout. Renders:
            small uppercase brand line in suite amber
            large charcoal-navy report title
            optional company / period strip
    -->
    <template id="eh_report_header">
        <div class="eh_pdf_header">
            <div class="eh_pdf_header_brand">ERP Heritage Accounting Suite</div>
            <h1 class="eh_pdf_title" t-out="title"/>
            <div class="eh_pdf_header_company"
                 t-if="company">
                <t t-out="company.display_name"/>
                <span t-if="company.country_id"> / <t t-out="company.country_id.name"/></span>
            </div>
        </div>
    </template>

    <!--
        Minimal layout shell for suite reports. Bridges the gap
        between web.html_container (which only provides the outer
        document scaffolding) and web.external_layout (which would
        also dump the company logo + name + address inline before
        the report body, overlapping the report title on dense
        layouts). Our reports want their own branded header band
        rendered via eh_report_header; this template provides the
        outer wrapper, the qweb_pdf body class wkhtmltopdf expects,
        and the wkhtmltopdf footer band so page numbers still appear.

        FONT: wkhtmltopdf renders the footer band as a separate sub
        document, so the stylesheet a report t-calls inside the body
        (eh_report_styles, which pins the suite stack on .eh_pdf_page)
        never reaches it.  Left to inherit, the footer picks up the
        company's configured web font.  wkhtmltopdf 0.12.6 collapses the
        several @font-face faces of one web family into a single
        embedded font with no glyph outlines, so the band silently
        printed blank on roughly half the pages: no company name and no
        page numbers on a financial statement.  The same stack the body
        pins is therefore repeated here, on the band itself, so the
        footer never depends on the company web font.
    -->
    <template id="eh_clean_layout">
        <div t-attf-class="footer o_company_#{company.id if company else 'na'}_layout"
             style="font-family: &quot;DM Sans&quot;, &quot;Helvetica Neue&quot;, Arial, sans-serif;">
            <div class="o_footer_content d-flex border-top pt-2"
                 style="font-family: &quot;DM Sans&quot;, &quot;Helvetica Neue&quot;, Arial, sans-serif; font-size: 7.5pt; color: #6c757d; padding-top: 4pt;">
                <div class="flex-grow-1 text-start me-2">
                    <t t-if="company" t-out="company.display_name"/>
                </div>
                <div class="text-end text-muted text-nowrap"
                     t-if="report_type == 'pdf'">
                    Page <span class="page"/> / <span class="topage"/>
                </div>
            </div>
        </div>
        <div class="article o_report_layout_standard">
            <t t-out="0"/>
        </div>
    </template>

    <!--
        Letterhead and page-footer typography for reports that keep the
        company's own layout.

        The stock letterhead and footer are handed to the PDF engine as
        their own small documents, and the engine fetches the company web
        font over HTTP while it lays them out.  When that fetch does not
        land in time the engine drops every run of text set in that face
        and says nothing, so the band prints with the company address or
        the page numbers simply absent.  Measured on the demo database:
        the address survived 5 of 8 identical renders untouched, and 8 of
        8 once the band was pinned to installed faces.

        Only reports that ask for it are affected.  A report opts in by
        setting eh_pin_report_fonts before it calls web.external_layout,
        which the suite reports do and no other report does, so a
        customer's own documents keep the letterhead font they chose in
        Settings.  web.company_address_list and
        web.external_layout_footer_content are the two blocks every stock
        layout draws inside its header and footer band, which is where
        the style has to sit: the engine keeps only the header, footer
        and article subtrees.
    -->
    <template id="eh_report_letterhead_fonts" inherit_id="web.company_address_list">
        <xpath expr="//ul" position="before">
            <style t-if="eh_pin_report_fonts" type="text/css">
                .header, .header * {
                    font-family: "DM Sans", "Helvetica Neue", Arial, sans-serif;
                }
            </style>
        </xpath>
    </template>

    <template id="eh_report_page_footer_fonts"
              inherit_id="web.external_layout_footer_content">
        <xpath expr="//table[1]" position="before">
            <style t-if="eh_pin_report_fonts" type="text/css">
                .footer, .footer * {
                    font-family: "DM Sans", "Helvetica Neue", Arial, sans-serif;
                }
            </style>
        </xpath>
    </template>

</odoo>
