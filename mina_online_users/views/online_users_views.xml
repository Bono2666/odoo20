<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mail_presence_view_list" model="ir.ui.view">
        <field name="name">mail.presence.list.online.users</field>
        <field name="model">mail.presence</field>
        <field name="arch" type="xml">
            <list string="Online Users"
                  js_class="mina_online_users.auto_refresh_list"
                  default_order="last_poll desc"
                  create="false"
                  delete="false">
                <field name="user_id"/>
                <field name="login" optional="show"/>
                <field name="status" widget="badge"
                        decoration-success="status == 'online'"
                        decoration-warning="status == 'away'"
                        decoration-muted="status == 'offline'"/>
                <field name="last_poll" string="Last Seen"/>
                <field name="last_presence" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="mail_presence_view_search" model="ir.ui.view">
        <field name="name">mail.presence.search.online.users</field>
        <field name="model">mail.presence</field>
        <field name="arch" type="xml">
            <search string="Online Users">
                <field name="user_id"/>
                <field name="status"/>
                <filter name="active" string="Currently Active"
                        domain="[('status', 'in', ('online', 'away'))]"/>
                <separator/>
                <filter name="online" string="Online" domain="[('status', '=', 'online')]"/>
                <filter name="away" string="Away" domain="[('status', '=', 'away')]"/>
                <filter name="offline" string="Offline" domain="[('status', '=', 'offline')]"/>
                <group>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_online_users" model="ir.actions.act_window">
        <field name="name">Online Users</field>
        <field name="res_model">mail.presence</field>
        <field name="path">online-users</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="mail_presence_view_list"/>
        <field name="search_view_id" ref="mail_presence_view_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <menuitem id="menu_online_users"
              name="Online Users"
              parent="base.menu_users"
              action="action_online_users"
              sequence="1"
              groups="base.group_system"/>

</odoo>
