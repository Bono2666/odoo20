<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The partner domain of these documents uses the tag of the company -->
    <record id="sale_order_view_form_partner_filter" model="ir.ui.view">
        <field name="name">sale.order.form.mina.partner.filter</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="mina_partner_category_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_view_form_partner_filter" model="ir.ui.view">
        <field name="name">purchase.order.form.mina.partner.filter</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="mina_partner_category_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="account_move_view_form_partner_filter" model="ir.ui.view">
        <field name="name">account.move.form.mina.partner.filter</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="mina_partner_category_id" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
