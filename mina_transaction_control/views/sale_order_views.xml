<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_view_form_price_approval" model="ir.ui.view">
        <field name="name">sale.order.form.mina.price.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_mina_request_approval" type="object" string="Minta Approval Harga"
                        class="btn-primary" icon="fa-paper-plane"
                        invisible="state not in ('draft', 'sent') or mina_approval_state not in ('to_request', 'rejected')"/>
                <button name="action_mina_approve" type="object" string="Setujui Harga"
                        class="btn-success" icon="fa-check" groups="sales_team.group_sale_manager"
                        invisible="state not in ('draft', 'sent') or mina_approval_state not in ('to_request', 'pending', 'rejected')"/>
                <button name="action_mina_reject" type="object" string="Tolak Harga"
                        icon="fa-times" groups="sales_team.group_sale_manager"
                        invisible="state not in ('draft', 'sent') or mina_approval_state not in ('to_request', 'pending')"/>
            </xpath>
            <xpath expr="//header" position="after">
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="state not in ('draft', 'sent') or mina_approval_state not in ('to_request', 'pending', 'rejected')">
                    <span invisible="mina_approval_state != 'to_request'">
                        Ada harga jual di bawah harga pricelist (baris merah). Klik <b>Minta Approval Harga</b> sebelum order dikonfirmasi.
                    </span>
                    <span invisible="mina_approval_state != 'pending'">
                        Menunggu approval harga dari Sales Administrator.
                    </span>
                    <span invisible="mina_approval_state != 'rejected'">
                        Harga ditolak oleh <field name="mina_approval_user_id" readonly="1" class="fw-bold"/>. Ubah harga/diskon atau minta approval lagi.
                    </span>
                </div>
            </xpath>
            <xpath expr="//group[@name='order_details']" position="inside">
                <field name="mina_approval_state" widget="badge" invisible="mina_approval_state == 'not_required'"
                       decoration-warning="mina_approval_state in ('to_request', 'pending')"
                       decoration-success="mina_approval_state == 'approved'"
                       decoration-danger="mina_approval_state == 'rejected'"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//column[@name='price_unit']" position="before">
                <field name="mina_needs_approval" column_invisible="True"/>
                <field name="mina_reference_price" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//column[@name='price_unit']/field[@name='price_unit']" position="attributes">
                <attribute name="decoration-danger">mina_needs_approval</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list" position="attributes">
                <attribute name="decoration-danger">mina_needs_approval</attribute>
            </xpath>
        </field>
    </record>

    <record id="sale_order_view_list_price_approval" model="ir.ui.view">
        <field name="name">sale.order.list.mina.price.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="mina_approval_state" optional="show" widget="badge"
                       invisible="mina_approval_state == 'not_required'"
                       decoration-warning="mina_approval_state in ('to_request', 'pending')"
                       decoration-success="mina_approval_state == 'approved'"
                       decoration-danger="mina_approval_state == 'rejected'"/>
            </field>
        </field>
    </record>

    <record id="sale_order_view_search_price_approval" model="ir.ui.view">
        <field name="name">sale.order.search.mina.price.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <filter name="my_sale_orders_filter" position="after">
                <separator/>
                <filter name="mina_approval_waiting" string="Menunggu Approval Harga"
                        domain="[('mina_approval_state', '=', 'pending')]"/>
                <filter name="mina_approval_needed" string="Perlu Approval Harga"
                        domain="[('mina_approval_state', 'in', ('to_request', 'rejected'))]"/>
            </filter>
        </field>
    </record>

</odoo>
