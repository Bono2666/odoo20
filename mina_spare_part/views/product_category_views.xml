<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_category_form_view" model="ir.ui.view">
        <field name="name">product.category.form.inherit.mina.spare.part</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <field name="parent_id" position="after">
                <field name="part_type" class="oe_inline"/>
            </field>
        </field>
    </record>

    <record id="product_category_list_view" model="ir.ui.view">
        <field name="name">product.category.list.inherit.mina.spare.part</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <field name="display_name" position="after">
                <field name="part_type" optional="show"/>
            </field>
        </field>
    </record>

    <record id="mina_part_category_action" model="ir.actions.act_window">
        <field name="name">Kategori Part</field>
        <field name="res_model">product.category</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('part_type', '!=', False)]</field>
        <field name="context">{'default_part_type': 'engine'}</field>
    </record>

</odoo>
