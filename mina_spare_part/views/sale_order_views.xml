<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mina_part_sale_order_view_form" model="ir.ui.view">
        <field name="name">sale.order.view.form.mina.part</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//column[@name='product_and_description']" position="after">
                <field name="mina_substitute_count" column_invisible="True"/>
                <field name="mina_part_type" column_invisible="True"/>
                <field name="is_storable" column_invisible="True"/>
                <field name="mina_qty_available" optional="show" invisible="not is_storable"
                       decoration-danger="is_storable and mina_qty_available &lt;= 0"/>
                <button name="action_mina_view_stock" type="object" icon="fa-cubes"
                        title="Stok per Lokasi" invisible="not is_storable"/>
                <field name="mina_part_stock_jpn" string="Stock JPN" optional="show" invisible="not mina_part_type"/>
                <field name="mina_part_lead_time" string="Lead Time" optional="show" invisible="not mina_part_type"/>
                <field name="mina_part_availability" optional="show" widget="badge"
                       decoration-success="mina_part_availability == 'available'"
                       decoration-warning="mina_part_availability == 'substituted'"
                       decoration-danger="mina_part_availability == 'discontinued'"/>
                <field name="mina_part_replacement_id" optional="show" invisible="not mina_part_replacement_id"
                       options="{'no_open': True}"/>
                <field name="mina_part_replacement_price" optional="show" invisible="not mina_part_replacement_id"/>
                <field name="mina_part_earliest_ids" optional="show" widget="many2many_tags"
                       invisible="not mina_part_earliest_ids"/>
                <button name="action_mina_open_substitute" type="object" icon="fa-exchange"
                        title="Ganti dengan Part Substitusi"
                        invisible="not mina_substitute_count or parent.state not in ('draft', 'sent')"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//div[@name='lead']" position="after">
                <field name="mina_part_type" invisible="1"/>
                <field name="is_storable" invisible="1"/>
                <label for="mina_qty_available" invisible="not is_storable"/>
                <div class="o_row" invisible="not is_storable">
                    <field name="mina_qty_available"/>
                    <button name="action_mina_view_stock" type="object" icon="fa-cubes"
                            string="Per Lokasi" class="btn-link"/>
                </div>
                <field name="mina_part_stock_jpn" invisible="not mina_part_type"/>
                <field name="mina_part_lead_time" invisible="not mina_part_type"/>
                <field name="mina_part_availability" invisible="not mina_part_type" widget="badge"
                       decoration-success="mina_part_availability == 'available'"
                       decoration-warning="mina_part_availability == 'substituted'"
                       decoration-danger="mina_part_availability == 'discontinued'"/>
                <field name="mina_part_replacement_id" invisible="not mina_part_replacement_id"/>
                <field name="mina_part_replacement_price" invisible="not mina_part_replacement_id"/>
                <field name="mina_part_earliest_ids" widget="many2many_tags" invisible="not mina_part_earliest_ids"/>
            </xpath>
        </field>
    </record>

</odoo>
