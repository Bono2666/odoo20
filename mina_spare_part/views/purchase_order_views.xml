<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mina_part_purchase_order_view_form" model="ir.ui.view">
        <field name="name">purchase.order.view.form.mina.part</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//column[@name='product_and_description']" position="after">
                <field name="mina_substitute_count" column_invisible="True"/>
                <field name="mina_part_availability" optional="show" widget="badge"
                       decoration-success="mina_part_availability == 'available'"
                       decoration-warning="mina_part_availability == 'substituted'"
                       decoration-danger="mina_part_availability == 'discontinued'"/>
                <button name="action_mina_open_substitute" type="object" icon="fa-exchange"
                        title="Ganti dengan Part Substitusi"
                        invisible="not mina_substitute_count or parent.state not in ('draft', 'sent')"/>
            </xpath>
        </field>
    </record>

</odoo>
